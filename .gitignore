# ============================================
# Environment Files (Keep secrets out of git)
# ============================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Explicitly track env example templates
!.env.example
!.env.*.example

# ============================================
# Dependencies
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================
# Build & Distribution Outputs
# ============================================
dist/
build/
out/
.cache/

# ============================================
# Operating System Files
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ============================================
# Editor & IDE Configs
# ============================================
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# ============================================
# Logs & Temporary Files
# ============================================
logs/
*.log
*.tmp
*.bak

